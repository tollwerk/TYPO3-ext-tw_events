{
    "name": "tollwerk/tw-events",
    "description": "Events with their programme, people, organisations and documentation for TYPO3. Part of the Attendance Kit",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "require": {
        "php": "^8.5",
        "tollwerk/tw-accounts": "^14.0",
        "tollwerk/tw-base": "^14.0",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-frontend": "^14.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^13",
        "saschaegerer/phpstan-typo3": "*",
        "ssch/typo3-rector": "*",
        "tollwerk/guidelines": "dev-main",
        "typo3/cms-fluid-styled-content": "^14.3",
        "typo3/testing-framework": "^9.7"
    },
    "repositories": [
        {
            "name": "tollwerk-tw-accounts",
            "type": "vcs",
            "url": "git@code.tollwerk.net:tollwerk/typo3/extensions/tw-accounts.git"
        },
        {
            "name": "tollwerk-tw-base",
            "type": "vcs",
            "url": "git@code.tollwerk.net:tollwerk/typo3/extensions/tw-base.git"
        },
        {
            "name": "tollwerk-tw-antibot",
            "type": "vcs",
            "url": "git@code.tollwerk.net:tollwerk/typo3/extensions/tw-antibot.git"
        },
        {
            "name": "tollwerk-tw-fields",
            "type": "vcs",
            "url": "git@code.tollwerk.net:tollwerk/typo3/extensions/tw-fields.git"
        },
        {
            "name": "tollwerk-guidelines",
            "type": "vcs",
            "url": "git@code.tollwerk.net:tollwerk/guidelines.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tollwerk\\TwEvents\\": "Classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "platform": {
            "php": "8.5.0"
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "14.x-dev"
        },
        "typo3/cms": {
            "extension-key": "tw_events"
        }
    },
    "scripts": {
        "post-install-cmd": "test ! -x vendor/bin/guidelines || vendor/bin/guidelines install",
        "post-update-cmd": "test ! -x vendor/bin/guidelines || vendor/bin/guidelines install",
        "check": "guidelines gate",
        "fix": "guidelines fix"
    }
}
