plugin.tx_twevents {
    view {
        templateRootPaths.0 = EXT:tw_events/Resources/Private/Templates/
        layoutRootPaths.0 = EXT:tw_events/Resources/Private/Layouts/
    }
}

# Detail views name their record in the page title
config.pageTitleProviders.twEvents {
    provider = Tollwerk\TwEvents\Page\RecordTitleProvider
    before = recordTitle, record, seo
}
